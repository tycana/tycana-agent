# tycanad: the Tycana host agent, observe-only (ADR 0009, ADR 0017).
# Scored in CI with `systemd-analyze security`; see Makefile target security-score.
[Unit]
Description=Tycana host agent (observe-only)
Documentation=https://github.com/tycana/tycana-agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/tycanad --config /etc/tycana/tycanad.yaml
Restart=on-failure
RestartSec=10s
# Status 3: the binary differs from the one its package installed
# (self-check, tycana-hq ADR 0025). A restart cannot fix that, and the
# status stays a failure, so monitoring sees it.
RestartPreventExitStatus=3

# Identity: a dedicated unprivileged system user from
# packaging/sysusers.d/tycana.conf. No capabilities at all. Not
# DynamicUser=: dbus-daemon refuses DynamicUser clients, and the agent
# reads unit state over D-Bus (M2). The settings DynamicUser= implied are
# set explicitly below (PrivateTmp, RemoveIPC, ProtectSystem, ProtectHome,
# NoNewPrivileges, RestrictSUIDSGID).
User=tycana
Group=tycana
StateDirectory=tycanad
StateDirectoryMode=0700
ConfigurationDirectory=tycana
RuntimeDirectory=tycanad
RuntimeDirectoryMode=0700
UMask=0077
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
SecureBits=noroot-locked

# Filesystem: everything read-only except the state directory above.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
# No PrivateUsers= (ADR 0024): in a private user namespace every owner
# other than root and tycana reads as 65534, so the baseline could not
# check file owners and groups. It added little here: the unit has no
# capabilities to confine, NoNewPrivileges and noroot-locked block
# gaining any, and RestrictNamespaces=yes blocks new user namespaces.
# Measured on the four lab VMs, 2026-10-17.
# ProtectProc=default (tycana-hq ADR 0032, Mark 2026-10-17): the agent
# reads argv[0] of each running unit's main process, and keeps it only
# when it is the path of a packaged program. This shows every process's
# name and command line, as ps shows them to any local user; the ptrace
# check still closes maps, environ, fd, and mem of other users. Before
# ADR 0032 this was "invisible", which hid other users' processes.
ProtectProc=default
# ProcSubset=pid would hide /proc/sys, which the observer reads for the
# running kernel (M1) and sysctl baseline checks (M3). /proc/sys stays
# read-only through ProtectKernelTunables. Verified with
# scripts/lab-sandbox.sh on tycana-ubuntu2404, 2026-10-15.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# The observer must read package databases and unit state; these are world-readable.
# "-" marks paths a host may not have: without it systemd fails the unit's
# namespace (status 226/NAMESPACE) on every host missing one of them, as
# AlmaLinux 9 did for the dpkg paths on 2026-10-16.
ReadOnlyPaths=-/var/lib/dpkg -/var/lib/rpm -/usr/lib/sysimage/rpm -/var/lib/apt -/var/lib/dnf -/var/cache/dnf -/run/systemd
# /etc/shadow and /etc/gshadow are not listed: they are unreadable to the
# dynamic user already (mode 0000 or root:shadow 0640), and listing them
# fails the namespace on systemd 252 with SELinux enforcing (AlmaLinux 9,
# "Permission denied" mounting over a mode-0000 file, 2026-10-16).
# /etc/ssh stays readable (M3): the baseline reads sshd_config, which is
# 0644 on Debian and Ubuntu, and the mode and owner of the host keys. The
# private keys are 0600 root (or 0640 root:ssh_keys on RHEL), so the
# agent's user cannot read them; before M3 this list also hid /etc/ssh.
InaccessiblePaths=-/root -/home

# No PrivateNetwork=: the net.* sysctls are per network namespace, and the
# baseline must read the host's, not an empty namespace's.

# Kernel surface.
# AF_NETLINK (tycana-hq ADR 0029, Mark 2026-10-17): the agent asks the
# kernel's socket diagnostics (sock_diag) which cgroup holds each
# listening socket. The dump is open to every user; changes over netlink
# need CAP_NET_ADMIN, which the unit cannot get.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @reboot @swap @obsolete @cpu-emulation @debug @module @raw-io @clock
SystemCallErrorNumber=EPERM
DevicePolicy=closed
KeyringMode=private
NotifyAccess=none

# Resources: the agent is meant to be tiny (spec §8).
# 384M (Mark, 2026-10-18, tycana-hq ADR 0025 item 6): tycanad itself
# uses 8-30 MiB, but apt-get and dnf run inside this cgroup for the
# update list. dnf on Oracle Linux 9 as a non-root user needs about
# 292 MiB (its repository metadata and file lists); at 256M without swap
# the kernel killed it in 10 of 10 runs. Measured 2026-10-18.
# The agent also ends a cycle that runs longer than 10 minutes (exit
# status 4; Restart=on-failure starts it again).
MemoryMax=384M
TasksMax=64
CPUQuota=20%

[Install]
WantedBy=multi-user.target
