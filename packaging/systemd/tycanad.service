# tycanad: the Tycana host agent, observe-only (ADR 0009, ADR 0017).
# Scored in CI with `systemd-analyze security`; see Makefile target security-score.
[Unit]
Description=Tycana host agent (observe-only)
Documentation=https://github.com/tycana/tycana-agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/tycanad --config /etc/tycana/tycanad.yaml
Restart=on-failure
RestartSec=10s

# Identity: a dedicated, system-managed unprivileged user. No capabilities at all.
DynamicUser=yes
User=tycanad
Group=tycanad
StateDirectory=tycanad
StateDirectoryMode=0700
ConfigurationDirectory=tycana
RuntimeDirectory=tycanad
RuntimeDirectoryMode=0700
UMask=0077
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
SecureBits=noroot-locked

# Filesystem: everything read-only except the state directory above.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectProc=invisible
# ProcSubset=pid would hide /proc/sys, which the observer reads for the
# running kernel (M1) and sysctl baseline checks (M3). /proc/sys stays
# read-only through ProtectKernelTunables. Verified with
# scripts/lab-sandbox.sh on tycana-ubuntu2404, 2026-10-15.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# The observer must read package databases and unit state; these are world-readable.
ReadOnlyPaths=/var/lib/dpkg /var/lib/rpm /usr/lib/sysimage/rpm /var/lib/apt /var/cache/dnf /run/systemd
InaccessiblePaths=-/root -/home -/etc/shadow -/etc/gshadow -/etc/ssh

# Kernel surface.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @reboot @swap @obsolete @cpu-emulation @debug @module @raw-io @clock
SystemCallErrorNumber=EPERM
DevicePolicy=closed
KeyringMode=private
NotifyAccess=none

# Resources: the agent is meant to be tiny (spec §8).
MemoryMax=128M
TasksMax=64
CPUQuota=20%

[Install]
WantedBy=multi-user.target
